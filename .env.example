# Copy to .env (git-ignored) and fill in. Used by tools/deploy.sh, tools/screens.py and the other tools.
# Your bar's IP on Wi-Fi (shown in the bar's web UI / your router). Leave unset to use USB (10.0.4.20).
BUSYBAR_ADDR=192.168.1.50
# Only if you turned on "Password protection" for the HTTP API. Never commit this.
BUSYBAR_TOKEN=
